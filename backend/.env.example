MONGO_URI=mongodb://127.0.0.1:27017/ai_task_scheduler
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Optional: without this key, the scheduler uses its local fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional SMTP settings for email reminders.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_SECURE=false
